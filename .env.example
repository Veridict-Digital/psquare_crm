# Copy this file to .env and fill in real values before deploying
# Never commit .env to git

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DEBUG=False
# Comma-separated: your Coolify domain + localhost for health checks
ALLOWED_HOSTS=yourdomain.com,localhost
# Comma-separated origins the browser is allowed to call the API from
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=psquare_crm
POSTGRES_USER=psquare_user
POSTGRES_PASSWORD=replace-with-a-strong-password
# Constructed automatically from the above — override only if using an external DB
DATABASE_URL=postgresql://psquare_user:replace-with-a-strong-password@db:5432/psquare_crm

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=yourmail@gmail.com
